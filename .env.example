# ==========================================================
# Artist Radar – environment template
# Copy this file to `.env` and fill in real values.
# ==========================================================

# ----- Spotify API ----------------------------------------
# Create an app at https://developer.spotify.com/dashboard
# Then copy the Client ID + Client Secret from the app page.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ----- Bandsintown API ------------------------------------
# Bandsintown's public API is keyed by an arbitrary `app_id`.
# Pick any unique string – e.g. your project name.
# Docs: https://artists.bandsintown.com/support/public-api
BANDSINTOWN_APP_ID=artist-radar

# ----- Email alerts (SMTP via Nodemailer) -----------------
# Gmail example: enable 2FA, then create an App Password
# at https://myaccount.google.com/apppasswords and use it as SMTP_PASS.
EMAIL_FROM="Artist Radar <radar@example.com>"
EMAIL_TO=you@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ----- Discovery thresholds -------------------------------
# Only flag artists below this follower count as "emerging".
# Spotify's official API doesn't expose monthly listeners, so we
# use follower count + popularity as proxies.
MAX_FOLLOWERS=500000

# The set of discovery playlists lives in
# backend/src/config/discoveryPlaylists.js — edit that file to add
# or remove playlists. Categories can be toggled live from the UI.

# ----- Scheduling -----------------------------------------
# How often background refresh runs. Default: every 24h at 09:00.
REFRESH_CRON=0 9 * * *

# ----- Server ---------------------------------------------
PORT=4000
DATABASE_PATH=./data/radar.db
